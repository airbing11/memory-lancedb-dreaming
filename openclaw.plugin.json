{
  "id": "memory-lancedb-dreaming",
  "name": "Dreaming (LanceDB)",
  "description": "Light/REM/Deep dreaming for memory-lancedb: isolated session cron, narrative DREAMS.md, promotion, and daily report (zero-LLM file summary + optional push to Feishu/WeCom/etc. via dailyReport.delivery).",
  "version": "0.3.13",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "dreaming_status",
      "dreaming_trigger",
      "dreaming_doctor"
    ]
  },
  "toolMetadata": {
    "dreaming_status": {
      "description": "Check dreaming plugin status, memory stats, and last dream report",
      "optional": true
    },
    "dreaming_trigger": {
      "description": "Manually trigger a dreaming cycle (Light/REM/Deep)",
      "optional": true
    },
    "dreaming_doctor": {
      "description": "Self-check the dreaming plugin: hooks, model override, install path, LanceDB slot, cron collision, daily report delivery, and Deep idle streak.",
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable dreaming functionality"
      },
      "cron": {
        "type": "string",
        "default": "0 3 * * *",
        "description": "Cron expression for the daily deep dreaming run (default: 3am daily)"
      },
      "timezone": {
        "type": "string",
        "default": "Asia/Shanghai",
        "description": "IANA timezone for cron scheduling"
      },
      "light": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "lookbackDays": {
            "type": "number",
            "default": 2
          },
          "limit": {
            "type": "number",
            "default": 100
          }
        }
      },
      "rem": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "lookbackDays": {
            "type": "number",
            "default": 7
          },
          "limit": {
            "type": "number",
            "default": 10
          },
          "minPatternStrength": {
            "type": "number",
            "default": 0.45
          },
          "lastingTruthCooldownDays": {
            "type": "number",
            "default": 7
          },
          "clusterSpotlightCooldownDays": {
            "type": "number",
            "default": 5
          },
          "truthDedupeWindowDays": {
            "type": "number",
            "default": 30,
            "description": "Look back this many days of REM history and skip lasting truths whose TEXT is semantically near an already-surfaced truth"
          },
          "truthSimilarityThreshold": {
            "type": "number",
            "default": 0.42,
            "description": "Similarity (0-1) at or above which a candidate truth is treated as a repeat of a recent truth and skipped"
          },
          "excludePromoted": {
            "type": "boolean",
            "default": true,
            "description": "Skip memories already promoted into MEMORY.md when selecting lasting truths"
          },
          "model": {
            "type": "string",
            "description": "Model override for REM semantic theme naming (alias: rem.execution.model). Requires plugins.entries.memory-lancedb-dreaming.subagent.allowModelOverride=true and hooks.allowConversationAccess=true."
          },
          "execution": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              }
            }
          }
        }
      },
      "deep": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "maxPromotions": {
            "type": "number",
            "default": 5
          },
          "limit": {
            "type": "number",
            "description": "Deprecated: use maxPromotions"
          },
          "minScore": {
            "type": "number",
            "default": 0.7
          },
          "minRecallCount": {
            "type": "number",
            "default": 3
          },
          "minUniqueQueries": {
            "type": "number",
            "default": 1
          },
          "recencyHalfLifeDays": {
            "type": "number",
            "default": 14
          },
          "maxAgeDays": {
            "type": "number",
            "default": 30
          },
          "idleNoveltyAfterDays": {
            "type": "number",
            "default": 7,
            "description": "After this many consecutive zero-promotion days, REM enters novelty mode (tighter dedupe, no stale narrative reuse). Set 0 to disable."
          }
        }
      },
      "narrative": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "zh",
                "en"
              ]
            },
            "default": [
              "zh",
              "en"
            ]
          },
          "model": {
            "type": "string",
            "description": "Model override for narrative generation (falls back to rem.model). Requires subagent.allowModelOverride=true."
          },
          "execution": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string"
              }
            }
          }
        }
      },
      "autoManageCron": {
        "type": "boolean",
        "default": true,
        "description": "Automatically create and manage the dreaming cron job"
      },
      "verboseLogging": {
        "type": "boolean",
        "default": false,
        "description": "Enable verbose dreaming logs"
      },
      "dailyReport": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "cron": {
            "type": "string",
            "default": "0 4 * * *"
          },
          "timezone": {
            "type": "string"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "zh",
                "en"
              ]
            },
            "default": [
              "zh"
            ]
          },
          "delivery": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "announce",
                  "direct",
                  "webhook"
                ]
              },
              "pushOn": {
                "type": "string",
                "enum": [
                  "always",
                  "changed"
                ],
                "default": "changed",
                "description": "Push when report content changes (changed) or every scheduled run (always)"
              },
              "threadId": {},
              "accountId": {
                "type": "string"
              }
            },
            "required": [
              "channel",
              "to"
            ]
          }
        }
      }
    }
  }
}