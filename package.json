{
  "name": "memory-lancedb-dreaming",
  "version": "0.3.17",
  "description": "Dreaming plugin for memory-lancedb \u2014 Light/REM/Deep phases, DREAMS.md, daily report with optional channel push (Feishu/WeCom/etc.).",
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist/**/*.js",
    "openclaw.plugin.json",
    "README.md",
    "scripts/install.sh"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node scripts/test.mjs",
    "prepublishOnly": "npm run test"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.9",
      "minGatewayVersion": "2026.6.9"
    },
    "build": {
      "openclawVersion": "2026.7.2-beta.7",
      "pluginSdkVersion": "2026.7.2-beta.7"
    }
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.29.0",
    "apache-arrow": "^18.1.0",
    "typebox": "^1.0.0"
  },
  "devDependencies": {
    "openclaw": "2026.7.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@openclaw/memory-lancedb": ">=2026.6.9",
    "openclaw": ">=2026.6.9"
  },
  "peerDependenciesMeta": {
    "@openclaw/memory-lancedb": {
      "optional": true
    },
    "openclaw": {
      "optional": true
    }
  },
  "author": "airbing11",
  "homepage": "https://clawhub.ai/packages/memory-lancedb-dreaming",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airbing11/memory-lancedb-dreaming.git"
  },
  "bugs": {
    "url": "https://github.com/airbing11/memory-lancedb-dreaming/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "memory",
    "dreaming",
    "lancedb"
  ],
  "license": "MIT"
}